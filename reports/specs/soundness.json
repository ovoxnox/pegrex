 "plugins": [
  {
   "aliases": [
    "c11"
   ],
   "capabilities": [
    "audit",
    "cognitive",
    "contracts",
    "parse",
    "semantic-diff"
   ],
   "cfg": {
    "adapter": "pipeline.c_frontend.TagSpec->CFGBuilder",
    "supported_constructs": [
     "C11 grammar subset",
     "if/else",
     "loops",
     "return"
    ]
   },
   "contracts": {
    "features": [
     "path-constraints",
     "outcomes",
     "entrypoint-selection",
     "call-summary-expansion",
     "cross-variant-equivalence"
    ],
    "handler": "c_frontend",
    "mode": "pipeline",
    "outcome_renderer": "c"
   },
   "error_policy": "raise; scanner converts parser failure to PEGREX-PARSER-UNKNOWN",
   "expression_lowering": "integer constants; identifiers; comparisons",
   "extensions": [
    ".c",
    ".h"
   ],
   "known_unsupported": [
    "full C preprocessor semantics",
    "pointer/alias proof",
    "undefined-behavior model"
   ],
   "language": "c",
   "maturity": "stable",
   "normalizer": "c-peg->pegrex.Node",
   "notes": "Contract extraction uses the bundled C grammar.",
