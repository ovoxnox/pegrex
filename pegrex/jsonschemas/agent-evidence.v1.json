{
  "$id": "pegrex:pegrex.agent-evidence.v1:schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "data": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "schema": {
      "const": "pegrex.agent-evidence.v1"
    },
    "tool": {
      "minLength": 1,
      "type": "string"
    },
    "unknowns": {
      "items": {
        "type": [
          "string",
          "object"
        ]
      },
      "type": "array"
    },
    "verdict": {
      "enum": [
        "proved",
        "refuted",
        "unknown",
        "ok"
      ]
    }
  },
  "required": [
    "schema",
    "tool",
    "verdict",
    "data",
    "unknowns",
    "provenance"
  ],
  "title": "Typed agent evidence envelope",
  "type": "object"
}
