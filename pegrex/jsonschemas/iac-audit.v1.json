{
  "$id": "pegrex:pegrex.iac-audit.v1:schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "coverage": {
      "minLength": 1,
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "evidence": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "pegrex.iac-audit.v1"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "file",
    "findings",
    "coverage",
    "unknowns"
  ],
  "title": "Infrastructure-as-code audit result",
  "type": "object"
}
