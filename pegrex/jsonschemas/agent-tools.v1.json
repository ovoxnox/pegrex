{
  "$id": "pegrex:pegrex.agent-tools.v1:schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "pegrex.agent-tools.v1"
    },
    "tools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "type": "string"
          },
          "input": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "input",
          "output",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "tools"
  ],
  "title": "Agent tools manifest",
  "type": "object"
}
