{
  "$id": "https://pegrex.dev/schemas/certificate.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "const": "finite-domain-equivalent"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "additionalProperties": false,
            "properties": {
              "finite_domain_proof": {
                "type": "object"
              }
            },
            "required": [
              "finite_domain_proof"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim": {
            "const": "contract-set-identical"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "additionalProperties": false,
            "properties": {
              "after_contracts": {
                "maxItems": 10000,
                "type": "array"
              },
              "after_contracts_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "before_contracts": {
                "maxItems": 10000,
                "type": "array"
              },
              "before_contracts_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "before_contracts",
              "after_contracts"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "after_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "before_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "claim": {
      "enum": [
        "contract-set-identical",
        "equivalent",
        "patch-equivalent",
        "finite-domain-equivalent"
      ]
    },
    "counterexample": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "schema": {
      "const": "pegrex.certificate.v1"
    },
    "schema_version": {
      "const": 1
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "verdict": {
      "enum": [
        "proved",
        "refuted",
        "unknown"
      ]
    }
  },
  "required": [
    "schema",
    "schema_version",
    "verdict",
    "claim",
    "unknowns",
    "evidence"
  ],
  "title": "PegRex proof certificate v1",
  "type": "object"
}
